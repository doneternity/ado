APP_ENV=development
APP_BASE_URL=http://localhost:8080
PORT=8081
LOG_LEVEL=debug

DATABASE_URL=postgres://ado:ado@postgres:5432/ado?sslmode=disable
REDIS_URL=redis://redis:6379

SESSION_COOKIE_SECURE=false
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Required, at least 32 bytes. Encrypts provider API keys stored in the DB.
# Keep it stable: changing it makes previously stored provider keys unreadable.
# Generate one with: openssl rand -base64 48
PROVIDER_KEY_SECRET=

# Discord OAuth is the only sign-in method. Create an app at
# https://discord.com/developers/applications and add the redirect URL below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/api/auth/discord/callback
# Users must be members of this guild (and hold DISCORD_MEMBER_ROLE_ID, if set)
# or they are sent to /join-required. Empty = the ADO server's guild (config default).
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=

# Set to frontend URL when deploying on a different origin (e.g. Vercel + Koyeb).
# Leave empty for same-origin / local dev.
FRONTEND_ORIGIN=

# The first Discord account with this email becomes admin (only if no admin exists).
ADMIN_BOOTSTRAP_EMAIL=

# Background model health probing. 0 disables active probing.
MODEL_PROBE_INTERVAL_SECONDS=90
MODEL_PROBE_BATCH=2

# LLM providers are not configured via env — add them in the admin panel
# (/admin/providers) after signing in as admin.
