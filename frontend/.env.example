# Leave empty for local dev (nginx routes /api/* to the Go backend).
# Set to the backend URL when frontend and backend are on different origins.
VITE_API_BASE_URL=

# Discord invite link shown on the /join-required page, login, sign-up and footer.
# Falls back to https://discord.com/invite/adoai when unset.
VITE_DISCORD_INVITE_URL=
