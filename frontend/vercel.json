{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Content-Security-Policy",  "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://adoai.space; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(chat/completions|completions|embeddings|responses|messages|moderations|images/generations|audio/speech|audio/transcriptions)",
      "methods": ["POST"],
      "dest": "https://electric-babb-gemini-api-gateway-0468e30f.koyeb.app/api/missing-v1/$1",
      "transforms": [
        { "type": "request.headers", "op": "set", "target": { "key": "x-origin-secret" }, "args": "$ORIGIN_SECRET", "env": ["ORIGIN_SECRET"] }
      ]
    },
    {
      "src": "/api/(.*)",
      "dest": "https://electric-babb-gemini-api-gateway-0468e30f.koyeb.app/api/$1",
      "transforms": [
        { "type": "request.headers", "op": "set", "target": { "key": "x-origin-secret" }, "args": "$ORIGIN_SECRET", "env": ["ORIGIN_SECRET"] }
      ]
    },
    {
      "src": "/v1/(.*)",
      "dest": "https://electric-babb-gemini-api-gateway-0468e30f.koyeb.app/api/v1/$1",
      "transforms": [
        { "type": "request.headers", "op": "set", "target": { "key": "x-origin-secret" }, "args": "$ORIGIN_SECRET", "env": ["ORIGIN_SECRET"] }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite"
}
